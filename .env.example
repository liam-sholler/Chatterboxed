# Used by both the Vite frontend AND the Kotlin backend.
SHARED_SERVER_PORT=9943

# Used for the Vite frontend to know what server owns the API surface.
VITE_SERVER_PROTOCOL=http
VITE_SERVER_HOST=localhost

# Seperated by commas. Used for CORS by the Kotlin backend.
FRONTEND_URLS=http://localhost:5173

# The pepper used by the backend for extra protection against attacks.
# If you lose the password pepper, your users can't log in. Be careful.
PASSWORD_PEPPER=REPLACE_ME_PLEASE
